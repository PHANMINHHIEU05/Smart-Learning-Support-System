# ─── Supabase Database ───
# Connection string for asyncpg (direct connection, NOT pooler)
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─── Supabase Auth ───
# Found in: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ─── Supabase Project ───
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── App Settings ───
AI_WORKER_INTERNAL_TOKEN=replace-with-shared-internal-token
DICTIONARY_API_BASE_URL=https://api.dictionaryapi.dev
TRANSLATION_API_BASE_URL=https://api.mymemory.translated.net
VOCABULARY_HTTP_TIMEOUT_SECONDS=6
APP_NAME=Smart Learning Support System
APP_VERSION=1.0.0
DEBUG=false

# ─── CORS ───
# Comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Server ───
HOST=0.0.0.0
PORT=8000
