{
  "manifest_version": 2,
  "name": "SLSS Vocabulary Lookup",
  "version": "0.1.0",
  "description": "Capture selected English words from Firefox and save them to Smart Learning Support System.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs",
    "https://api.dictionaryapi.dev/*",
    "https://api.mymemory.translated.net/*"
  ],
  "browser_action": {
    "default_title": "SLSS Vocabulary",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
