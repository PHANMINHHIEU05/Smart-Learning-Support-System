# Environment variables for Smart Learning Support System frontend
# Copy this file to .env.local and fill in your values

# Legacy FastAPI backend URL for AI, monitoring, analytics, settings, and engagement
NEXT_PUBLIC_API_URL=http://localhost:8000

# Spring Boot backend URL for migrated main-backend APIs: auth/me, tasks, sessions, blocks
NEXT_PUBLIC_SPRING_API_URL=http://localhost:8080

# Supabase project credentials (from https://app.supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
